ACADEMY_ENVIRONMENT=development
ACADEMY_DATABASE_REQUIRED=false
ACADEMY_DATABASE_URL=postgresql+asyncpg://academy:change-me@127.0.0.1:5432/academy

# OIDC sign-in remains disabled until every required value below is configured.
# For a public OIDC client, leave ACADEMY_OIDC_CLIENT_SECRET unset.
# Generate the encryption key with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Generate the CSRF secret with: python -c "import secrets; print(secrets.token_urlsafe(48))"
# ACADEMY_OIDC_ISSUER=https://identity.example.com
# ACADEMY_OIDC_CLIENT_ID=academy-web
# ACADEMY_OIDC_CLIENT_SECRET=
# ACADEMY_OIDC_REDIRECT_URI=https://api.example.com/auth/callback
# ACADEMY_OIDC_TRANSACTION_ENCRYPTION_KEY=
# ACADEMY_OIDC_ALLOWED_ORIGINS=["https://academy.example.com"]
# ACADEMY_OIDC_POST_LOGIN_REDIRECT_URL=https://academy.example.com/
# ACADEMY_CSRF_SECRET=
# ACADEMY_SESSION_TTL_SECONDS=43200
# ACADEMY_SESSION_COOKIE_SECURE=true

# Keep disabled until non-owner PostgreSQL RLS acceptance and privacy review pass.
ACADEMY_LEARNER_DATA_API_ENABLED=false
